{
  "name": "vui-uniapp",
  "version": "1.2.0",
  "description": "Virtual UI (VUI) —— 基于 uni-app 的 Vue3 跨端组件库，48 个开箱即用的高质量组件，覆盖基础 / 表单 / 数据展示 / 反馈 / 媒体 / AI 场景，支持 iOS / Android / H5 / 各家小程序",
  "main": "index.js",
  "module": "index.js",
  "types": "types/index.d.ts",
  "files": [
    "index.js",
    "types/",
    "uni_modules/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "uni-app",
    "uniapp",
    "vue3",
    "vue",
    "ui",
    "ui-library",
    "component",
    "components",
    "vui",
    "小程序",
    "跨端",
    "组件库",
    "ai",
    "ai-ui",
    "chat-ui",
    "llm",
    "大模型",
    "chat",
    "markdown",
    "streaming"
  ],
  "license": "MIT",
  "author": "Virtualman <virtualman@yeah.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/virtualman333/vui.git"
  },
  "bugs": {
    "url": "https://github.com/virtualman333/vui/issues"
  },
  "homepage": "https://github.com/virtualman333/vui#readme",
  "peerDependencies": {
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vue/compiler-sfc": "^3.5.42",
    "sass": "^1.104.1",
    "typescript": "^7.0.2"
  },
  "sideEffects": [
    "*.scss",
    "*.css",
    "*.vue"
  ],
  "scripts": {
    "release": "node scripts/release.js",
    "check": "npm run check:all",
    "check:all": "node scripts/prepublish-check.js && node scripts/check-sfc.js && node scripts/check-entry.js && node scripts/check-types.js",
    "check:template": "node scripts/check-template-refs.js",
    "check:sfc": "node scripts/check-sfc.js",
    "check:entry": "node scripts/check-entry.js",
    "check:types": "node scripts/check-types.js",
    "theme:inject": "python scripts/inject-theme.py",
    "gen": "python scripts/gen-package.py && python scripts/gen-docs.py",
    "prepublishOnly": "npm run check:all",
    "pub": "npm publish --access public",
    "pack": "npm pack --dry-run"
  },
  "engines": {
    "HBuilderX": "^3.1.0"
  },
  "uni_modules": {
    "dependencies": [],
    "encrypt": [],
    "platforms": {
      "client": {
        "Vue": {
          "vue3": "u"
        }
      }
    }
  }
}
